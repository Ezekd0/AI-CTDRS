FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt

COPY ml ./ml
COPY backend ./backend
COPY scripts ./scripts
RUN pip install --upgrade pip && pip install -r requirements.txt
COPY reports ./reports

WORKDIR /app/backend
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["sh", "-c", "if [ ! -f /app/ml/artifacts/nsl_kdd/binary/random_forest/metadata.json ]; then cd /app && PYTHONPATH=/app python -m ml.training.train --dataset nsl-kdd --task binary --model random_forest --preprocess-if-missing; fi && cd /app/backend && PYTHONPATH=/app python /app/scripts/verify_production_artifacts.py --root /app/ml/artifacts && alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-2}"]
