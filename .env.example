APP_NAME=AI-CTDRS
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://your-frontend.example.com
ENABLE_API_DOCS=false
RESPONSE_MODE=SIMULATION
ARTIFACTS_ROOT=/app/ml/artifacts
REPORTS_ROOT=/app/reports
ALERT_PROBABILITY_THRESHOLD=0.75

POSTGRES_DB=ai_ctdrs
POSTGRES_USER=ai_ctdrs
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_DATABASE_PASSWORD

# Used by the frontend build. This must be the public HTTPS API base URL.
VITE_API_BASE_URL=https://your-api.example.com/api

# One-time main administrator setup; never store real secrets in this file.
ADMIN_BOOTSTRAP_ENABLED=false
# ADMIN_BOOTSTRAP_KEY=
# MAIN_ADMIN_EMAIL=
MAIN_ADMIN_FULL_NAME=Ospa Admin
